{
  "name": "@linxbox/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinxBox macOS Desktop: Electron UI, Companion Daemon and local execution facts",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.2",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm coverage",
    "dev": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --mac --dir",
    "probe:codex": "node scripts/probe-codex.mjs --out codex-capabilities.json --turn",
    "mock:gateway": "node scripts/mock-gateway.mjs",
    "mock:console": "node scripts/mock-gateway-console.mjs",
    "e2e:gateway-codex": "node scripts/e2e-wss-codex.mjs",
    "e2e:mock-console": "node scripts/e2e-mock-console.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "author": "Qiniu"
}
