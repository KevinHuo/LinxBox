{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KevinHuo/LinxBox/contracts/desktop-gateway.schema.json",
  "title": "Desktop 与 Gateway 消息",
  "oneOf": [
    {
      "$ref": "#/$defs/DesktopToGateway"
    },
    {
      "$ref": "#/$defs/GatewayToDesktop"
    }
  ],
  "$defs": {
    "PublicError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "CONFLICT",
            "RESOURCE_EXHAUSTED",
            "DEPENDENCY_UNAVAILABLE",
            "APPROVAL_REQUIRED",
            "POLICY_DENIED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "additionalProperties": false
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "task-result-v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "interrupted",
            "rejected"
          ]
        },
        "summary": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "outcome",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "needs_user_action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "voice_summary": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "contract_version",
        "status",
        "summary",
        "changes",
        "verification",
        "risks",
        "needs_user_action",
        "voice_summary"
      ],
      "additionalProperties": false
    },
    "Continuation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parent_task_id": {
              "$ref": "common.schema.json#/$defs/Id"
            }
          },
          "required": [
            "parent_task_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "agent_session_id": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "thread_id": {
              "$ref": "common.schema.json#/$defs/Id"
            }
          },
          "required": [
            "agent_session_id",
            "thread_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TaskEvent": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "event_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "event_id",
        "event_sequence",
        "occurred_at",
        "state",
        "stage",
        "summary",
        "result",
        "error",
        "thread_id",
        "turn_id"
      ],
      "additionalProperties": false
    },
    "client.hello": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "message_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "client.hello"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "desktop_version": {
              "type": "string",
              "minLength": 1
            },
            "protocol_versions": {
              "type": "array",
              "items": {
                "const": "1.0"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "last_acked_sequence": {
              "type": "integer",
              "minimum": 0
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "desktop_version",
            "protocol_versions",
            "last_acked_sequence",
            "capabilities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol_version",
        "message_id",
        "sequence",
        "type",
        "sent_at",
        "payload"
      ],
      "additionalProperties": false
    },
    "client.heartbeat": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "message_id": {
