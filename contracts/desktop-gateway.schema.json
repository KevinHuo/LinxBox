          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol_version",
        "message_id",
        "sequence",
        "type",
        "sent_at",
        "payload"
      ],
      "additionalProperties": false
    },
    "task.ack": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "message_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "task.ack"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "task_id": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "disposition": {
              "type": "string",
              "enum": [
                "accepted",
                "duplicate",
                "expired",
                "rejected"
              ]
            },
            "error": {
              "$ref": "#/$defs/PublicError"
            }
          },
          "required": [
            "message_id",
            "sequence",
            "task_id",
            "disposition"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol_version",
        "message_id",
        "sequence",
        "type",
        "sent_at",
        "payload"
      ],
      "additionalProperties": false
    },
