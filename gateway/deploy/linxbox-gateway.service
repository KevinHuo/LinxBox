[Unit]
Description=LinxBox Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linxbox
Group=linxbox
StateDirectory=linxbox
WorkingDirectory=/opt/linxbox
ExecStart=/opt/linxbox/bin/linxbox-gateway --config /etc/linxbox/gateway.json
Restart=on-failure
RestartSec=5
# 单实例：同一数据库同一时刻只运行一个服务。
# 运行日志交给 journald 采集。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linxbox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
